---
import Base from './Base.astro';

const {
  title = 'Field note',
  description = '',
  date,
  category = 'notes',
  tags = [],
} = Astro.props;

const dateValue = date ? new Date(date) : null;
const dateLabel = dateValue && !Number.isNaN(dateValue.getTime())
  ? dateValue.toLocaleDateString('en', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
  : 'Undated';
const slug = Astro.url.pathname.split('/').filter(Boolean).at(-1);
const renderedContent = await Astro.slots.render('default');
const wordCount = renderedContent.replace(/<[^>]*>/g, ' ').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));
---
<Base title={title} description={description}>
  <div class="shell page writing-post-page">
    <a class="post-back mono" href="/writing">← ALL NOTES / WRITING</a>
    <header class="post-heading">
      <div class="kicker">FIELD NOTE / {category}</div>
      <h1>{title}</h1>
      {description && <p class="page-intro">{description}</p>}
      <div class="article-meta post-meta">
        <time datetime={dateValue && !Number.isNaN(dateValue.getTime()) ? dateValue.toISOString().slice(0,10) : undefined}>{dateLabel}</time>
        <span>·</span>
        <span>{readingMinutes} MIN READ</span>
        {slug && <span>· NOTE #{slug}</span>}
      </div>
      {Array.isArray(tags) && tags.length > 0 && (
        <div class="tags post-tags">{tags.map((tag) => <span class="tag">#{tag}</span>)}</div>
      )}
    </header>
    <article class="article post-article">
      <div class="prose post-prose">
        <slot />
      </div>
      <footer class="post-end">
        <span class="mono">END OF NOTE</span>
        <a class="arrow mono" href="/writing">Back to the notebook ↑</a>
      </footer>
    </article>
    <p class="post-footer-note">These are personal learning notes. I update them as I test ideas, find mistakes, and learn better ways to explain things.</p>
  </div>
  <style>
    .writing-post-page { max-width: 820px; }
    .post-back { display:inline-block; color:var(--text-muted); font-size:9px; letter-spacing:.09em; margin-bottom:32px; }
    .post-back:hover { color:var(--accent); }
    .post-heading { padding-bottom:24px; border-bottom:1px solid var(--border-thin); margin-bottom:24px; }
    .post-heading h1 { max-width:760px; overflow-wrap:anywhere; }
    .post-heading .page-intro { margin-top:14px; margin-bottom:20px; }
    .post-meta { flex-wrap:wrap; gap:10px; margin-bottom:14px; }
    .post-tags { gap:6px; }
    .post-article { position:relative; padding:clamp(18px,4vw,34px); }
    .post-prose { max-width:680px; margin:0 auto; }
    .post-prose h2 { padding-top:8px; }
    .post-prose pre { overflow-x:auto; padding:16px; border:1px solid var(--border-thin); background:var(--panel); color:var(--text-light); font:12px/1.7 var(--mono); }
    .post-prose code { font-family:var(--mono); font-size:.92em; background:var(--accent-soft); padding:2px 4px; overflow-wrap:anywhere; }
    .post-prose pre code { background:transparent; padding:0; }
    .post-prose blockquote { margin:22px 0; padding:4px 0 4px 18px; border-left:2px solid var(--accent); color:var(--text-muted); }
    .post-prose a { color:var(--accent); text-decoration:underline; text-underline-offset:3px; }
    .post-end { display:flex; justify-content:space-between; flex-wrap:wrap; gap:16px; margin-top:38px; padding-top:14px; border-top:1px dashed var(--border-thin); color:var(--text-muted); font-size:9px; letter-spacing:.08em; }
    .post-footer-note { max-width:620px; margin:18px auto 0; color:var(--text-muted); font-size:11px; line-height:1.8; }
  </style>
</Base>
