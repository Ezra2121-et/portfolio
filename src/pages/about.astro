---
import Base from '../layouts/Base.astro';
import { site, stack, experience, certifications } from '../data/site';
---
<Base title="About" description="About Yosef Getnet: IT support, networking and cybersecurity.">
  <div class="shell page">
    <div class="kicker">About</div>
    <h1>Background.</h1>
    <p class="page-intro">Computer Science graduate focused on IT support, network operations and security operations.</p>
    <div class="article">
      <div class="prose">
        <p>{site.intro}</p>
        <p>I go by Jossy. I speak Amharic natively and work in English professionally, and I am based in {site.location}.</p>

        <h2>Experience</h2>
        {experience.map(job => (
          <>
            <h3>{job.role}</h3>
            <p><em>{job.org} · {job.period}</em></p>
            <ul>{job.points.map(point => <li>{point}</li>)}</ul>
          </>
        ))}

        <h2>Education</h2>
        <p>University of Gondar · BSc Computer Science · Graduated 2026</p>

        <h2>Certifications & training</h2>
        <ul>{certifications.map(([org, what]) => <li><strong>{org}:</strong> {what}</li>)}</ul>

        <h2>Technical competencies</h2>
        <div class="tags">{stack.map(s => <span class="tag">{s}</span>)}</div>

        <p style="margin-top:28px"><a class="arrow mono" href={site.resume}>Download my CV ↗</a></p>
      </div>
    </div>
  </div>
</Base>
