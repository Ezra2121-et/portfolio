---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import { site, projects, stack, currently } from '../data/site';
import type { MarkdownInstance } from 'astro';

interface WritingFrontmatter {
  title: string;
  date: string | Date;
  description?: string;
  category?: string;
  tags?: string[];
}

type WritingModule = MarkdownInstance<WritingFrontmatter>;

const featured = projects.slice(0, 3);
const writingPosts = Object.values(import.meta.glob<WritingModule>('./writing/*.md', { eager: true }))
  .filter((post) => Boolean(post.frontmatter?.title && post.url))
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
const recentWriting = writingPosts.slice(0, 5);

const metrics = [
  ['09', 'member team led at AMECO'],
  ['04', 'Cisco Academy courses completed'],
  ['03', 'featured project case studies'],
  ['05', 'technical notes & write-ups']
];
---

<Base title="Yosef Getnet">
  <div class="shell">

    <!-- HERO -->
    <section class="hero">

      <div class="hero-main">

        <!-- AVATAR -->
        <div class="hero-identity">
          <img
            class="avatar"
            src="/jossy.webp"
            alt="Portrait of Yosef Getnet"
            width="300"
            height="300"
            fetchpriority="high"
          />
        </div>

        <!-- INTRODUCTION -->
        <div class="hero-content">

          <div class="kicker">Portfolio</div>

          <h1>{site.name}</h1>

          <p class="subtitle">
            {site.title}
          </p>

          <p class="hero-intro">
            {site.intro}
          </p>

          <!-- SOCIAL LINKS -->
          <div class="socials">

            <a
              class="social-link"
              href={site.socials.github}
              target="_blank"
              rel="noreferrer"
            >
              <Icon name="github" />
              <span>GitHub</span>
            </a>

            <a
              class="social-link"
              href={site.socials.linkedin}
              target="_blank"
              rel="noreferrer"
            >
              <Icon name="linkedin" />
              <span>LinkedIn</span>
            </a>

            <a
              class="social-link"
              href={site.socials.twitter}
              target="_blank"
              rel="noreferrer"
            >
              <Icon name="twitter" />
              <span>X</span>
            </a>

            <a
              class="social-link"
              href={site.socials.discord}
              target="_blank"
              rel="noreferrer"
            >
              <Icon name="discord" />
              <span>Discord</span>
            </a>

            <a
              class="social-link"
              href={`mailto:${site.email}`}
            >
              <Icon name="mail" />
              <span>Email</span>
            </a>

          </div>

          <!-- ACTIONS -->
          <div class="button-row hero-actions">

            <a
              class="button primary"
              href="/work"
            >
              View my work →
            </a>

            <a
              class="button"
              href={site.resume}
            >
              Resume ↗
            </a>

          </div>

        </div>

      </div>


      <!-- WHOAMI -->
      <aside class="panel whoami-panel">

        <div class="panel-head">
          Quick Info
        </div>

        <div class="panel-body">

          <dl class="kv">

            <dt>name</dt>
            <dd>{site.name}</dd>

            <dt>alias</dt>
            <dd>{site.alias}</dd>

            <dt>specialization</dt>
            <dd>IT Support · Networking</dd>

            <dt>skills</dt>
            <dd>Linux · Python · Web Security</dd>

            <dt>education</dt>
            <dd>BSc Computer Science · 2026</dd>

            <dt>languages</dt>
            <dd>Amharic · English</dd>

            <dt>location</dt>
            <dd>{site.location}</dd>

            <dt>timezone</dt>
            <dd>{site.timezone}</dd>

            <dt>status</dt>
            <dd class="status">{site.status}</dd>

          </dl>

        </div>

      </aside>

    </section>


    <!-- DIVIDER -->
    <div class="rule"></div>


    <!-- FEATURED PROJECTS -->
    <section
      class="section"
      id="work"
    >

      <SectionHead
        label="Featured work"
        href="/work"
        action="view all work"
      />

      <div class="grid-3">

        {featured.map(project => (

          <article class="project panel" data-github-repo={project.source}>

            <div class="project-top">

              <span class="project-num">
                {project.number}
              </span>

              <span class="project-status">
                {project.status}
              </span>

            </div>

            <div>

              <div class="project-kind">
                {project.kind}
              </div>

              <h3 class="project-title">
                {project.title}
              </h3>

            </div>

            <p class="project-desc">
              {project.description}
            </p>

            <div class="tags">

              {project.stack.map(tag => (
                <span class="tag">
                  {tag}
                </span>
              ))}

            </div>

            <div class="project-foot">

              <span class="muted mono" data-repo-updated>
                {project.year}
              </span>

              <a
                class="arrow mono"
                href={project.href}
              >
                open →
              </a>

            </div>

          </article>

        ))}

      </div>

      <p class="muted mono" id="github-sync-status" aria-live="polite">
        Checking GitHub for the latest source-code updates…
      </p>

    </section>


    <!-- METRICS + TECH STACK -->
    <section
      class="section section-tight"
    >

      <div class="metrics">

        {metrics.map(([num, label]) => (

          <div class="metric">

            <div class="num">
              {num}
            </div>

            <div class="label">
              {label}
            </div>

          </div>

        ))}

      </div>


      <div class="stack-wrap">

        <span class="label">
          TECH STACK
        </span>

        <div class="tags">

          {stack.map(item => (
            <span class="tag">
              {item}
            </span>
          ))}

        </div>

      </div>

    </section>


    <!-- WRITING -->
    <section
      class="section"
      id="writing"
    >

      <SectionHead
        label="Writing"
        href="/writing"
        action="view all posts"
      />

      <div class="writing-list">

        {recentWriting.map(item => (

          <a
            class="writing-row"
            href={item.url ?? '/writing'}
          >

            <span class="writing-title">
              {item.frontmatter.title}
            </span>

            <span class="writing-meta">

              {(item.frontmatter.tags ?? []).map(tag => (
                <span>
                  #{tag}
                </span>
              ))}

            </span>

            <span class="writing-date">
              {new Date(item.frontmatter.date).toISOString().slice(0, 10)}
            </span>

          </a>

        ))}

      </div>

    </section>


    <!-- CURRENT / ACTIVITY / CONTACT -->
    <section class="section">

      <div class="trio">

        <!-- CURRENTLY -->
        <div class="panel list-panel">

          <div class="panel-head">
            [ACTIVE] Currently
          </div>

          <div class="list">

            {currently.map(item => (

              <div class="list-item">

                <span>
                  › {item}
                </span>

                <span>
                  +
                </span>

              </div>

            ))}

          </div>

        </div>


        <!-- SELECTED ACTIVITY -->
        <div class="panel list-panel">

          <div class="panel-head">
            [RECORD] Background & Training
          </div>

          <div class="list">

            <div class="list-item">
              <span>
                INSA cybersecurity bootcamp
              </span>
              <span>
                2026
              </span>
            </div>

            <div class="list-item">
              <span>
                University of Gondar · BSc CS
              </span>
              <span>
                2026
              </span>
            </div>

            <div class="list-item">
              <span>
                AMECO · full-stack internship
              </span>
              <span>
                2025
              </span>
            </div>

            <div class="list-item">
              <span>
                Cisco Networking Academy
              </span>
              <span>
                certificates
              </span>
            </div>

            <div class="list-item">
              <span>
                CCNA + ISC2 CC preparation
              </span>
              <span>
                ongoing
              </span>
            </div>

          </div>

        </div>


        <!-- CONTACT -->
        <div class="panel list-panel">

          <div class="panel-head">
            Contact
          </div>

          <div class="callout">

            <h3>
              Get in Touch
            </h3>

            <p>
              Open to IT Support, NOC and junior SOC roles in Addis Ababa. Happy to talk about opportunities, projects or an interesting problem.
            </p>

            <div class="button-row">

              <a
                class="button primary"
                href={`mailto:${site.email}`}
              >
                <Icon name="mail" />
                Email me
              </a>

            </div>


            <div
              class="socials"
              style="margin-top:18px"
            >

              <a
                class="social-link"
                href={site.socials.github}
                target="_blank"
                rel="noreferrer"
                aria-label="GitHub"
              >
                <Icon name="github" />
              </a>

              <a
                class="social-link"
                href={site.socials.linkedin}
                target="_blank"
                rel="noreferrer"
                aria-label="LinkedIn"
              >
                <Icon name="linkedin" />
              </a>

              <a
                class="social-link"
                href={site.socials.twitter}
                target="_blank"
                rel="noreferrer"
                aria-label="X"
              >
                <Icon name="twitter" />
              </a>

              <a
                class="social-link"
                href={site.socials.discord}
                target="_blank"
                rel="noreferrer"
                aria-label="Discord"
              >
                <Icon name="discord" />
              </a>

            </div>

          </div>

        </div>

      </div>

    </section>

  </div>
  <script>
    const githubCards = Array.from(document.querySelectorAll('[data-github-repo]'));
    const githubSyncStatus = document.querySelector('#github-sync-status');

    if (githubCards.length && githubSyncStatus) {
      fetch('https://api.github.com/users/Ezra2121-et/repos?per_page=100', {
        headers: { Accept: 'application/vnd.github+json' }
      })
        .then((response) => {
          if (!response.ok) throw new Error('GitHub repository lookup failed');
          return response.json();
        })
        .then((repositories) => {
          let updatedCards = 0;

          githubCards.forEach((card) => {
            const repoUrl = (card.dataset.githubRepo || '').toLowerCase();
            const repository = repositories.find(
              (item) => (item.html_url || '').toLowerCase() === repoUrl
            );
            const dateLabel = card.querySelector('[data-repo-updated]');

            if (repository && repository.pushed_at && dateLabel) {
              const date = new Date(repository.pushed_at);
              dateLabel.textContent = 'GitHub push · ' + date.toLocaleDateString(undefined, {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
              });
              updatedCards += 1;
            }
          });

          githubSyncStatus.textContent = updatedCards
            ? 'Project update dates synced from GitHub just now.'
            : 'GitHub is reachable, but update dates were not available.';
        })
        .catch(() => {
          githubSyncStatus.textContent =
            'Live GitHub dates are temporarily unavailable; project links and descriptions remain available.';
        });
    }
  </script>

</Base>