---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, projects, stack } from '../data/site';
import type { MarkdownInstance } from 'astro';

interface WritingFrontmatter {
  title: string;
  date: string | Date;
  description?: string;
  category?: string;
  tags?: string[];
}
type WritingModule = MarkdownInstance<WritingFrontmatter>;

const featured = projects.slice(0, 3);
const writingPosts = Object.values(import.meta.glob<WritingModule>('./writing/*.md', { eager: true }))
  .filter((post) => Boolean(post.frontmatter?.title && post.url))
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
const recentWriting = writingPosts.slice(0, 3);
const formatDate = (date: string | Date) =>
  new Date(date).toLocaleDateString('en', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base
  title="Yosef Getnet"
  description="Yosef Getnet is a Computer Science graduate in Addis Ababa focused on IT support, networking, cybersecurity and practical systems projects."
>
  <div class="shell home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-intro">
        <div class="home-photo-wrap">
          <img
            class="home-avatar"
            src="/jossy.webp?v=20261027"
            alt="Black-and-white portrait of Yosef Getnet"
            width="256"
            height="256"
            fetchpriority="high"
          />
          <div class="home-photo-caption"><span>Y.G. / 2026</span><span>ADDIS ABABA</span></div>
        </div>
        <div class="home-copy">
          <div class="kicker">COMPUTER SCIENCE GRADUATE / ETHIOPIA</div>
          <p class="home-greeting">Hi, I’m Yosef Getnet.</p>
          <h1 id="home-title">IT support and networking.<br /><span>Learning cybersecurity.</span></h1>
          <p class="home-role">{site.title}</p>
          <p class="home-bio">
            I graduated in Computer Science from the University of Gondar in 2026. I build small tools, troubleshoot network issues, and practise security using Linux and networking labs.
          </p>
          <div class="home-actions">
            <a class="home-button home-button-primary" href="#work">Explore my work <span aria-hidden="true">↓</span></a>
            <a class="home-button" href={'mailto:' + site.email}>Get in touch <Icon name="mail" /></a>
          </div>
          <div class="home-socials" aria-label="Social links">
            <a href={site.socials.github} target="_blank" rel="noreferrer"><Icon name="github" /> GitHub</a>
            <a href={site.socials.linkedin} target="_blank" rel="noreferrer"><Icon name="linkedin" /> LinkedIn</a>
            <a href={site.resume}>CV / Résumé ↗</a>
          </div>
        </div>
      </div>

      <aside class="home-profile-card" aria-label="Profile details">
        <div class="home-status"><span class="home-status-dot"></span>{site.status}</div>
        <div class="home-profile-rule"></div>
        <div class="home-detail">
          <span>BASED IN</span>
          <strong>{site.location}</strong>
        </div>
        <div class="home-detail">
          <span>EDUCATION</span>
          <strong>BSc Computer Science</strong>
          <small>University of Gondar · 2026</small>
        </div>
        <div class="home-detail">
          <span>INTERESTS</span>
          <strong>IT Support · Networking</strong>
          <strong>Cybersecurity · Linux</strong>
        </div>
        <a class="home-profile-contact" href={'mailto:' + site.email}>{site.email} <span aria-hidden="true">↗</span></a>
      </aside>
    </section>

    <section class="home-section" id="work" aria-labelledby="work-title">
      <div class="home-section-heading">
        <div>
          <div class="kicker">FEATURED PROJECTS / 01 - 03</div>
          <h2 id="work-title">Projects I have worked on.</h2>
          <p>Three projects, each with a case study and source code where available.</p>
        </div>
        <a class="home-text-link" href="/work">View all work <span aria-hidden="true">↗</span></a>
      </div>

      <div class="home-project-grid">
        {featured.map((project) => (
          <article class="home-project-card" data-github-repo={project.source}>
            <div class="home-project-top">
              <span class="home-project-number">PROJECT / {project.number}</span>
              <span class:list={['home-project-status', project.status === 'Functional prototype' && 'is-functional']}>{project.status}</span>
            </div>
            <div class="home-project-kind">{project.kind}</div>
            <h3>{project.title}</h3>
            <p class="home-project-description">{project.description}</p>
            <div class="home-project-tags">
              {project.stack.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <div class="home-project-footer">
              <span class="home-project-date" data-repo-updated>{project.year}</span>
              <div class="home-project-links">
                <a href={project.href}>Case study <span aria-hidden="true">↗</span></a>
                {project.source && <a href={project.source} target="_blank" rel="noreferrer" aria-label={'Source code for ' + project.title}><Icon name="github" /> Source</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="home-sync-status mono" id="github-sync-status" aria-live="polite">Project update dates are synced with GitHub when available.</p>
    </section>

    <section class="home-lower-grid">
      <div class="home-lower-card home-now-card">
        <div class="home-section-mini">
          <span class="kicker">CURRENT FOCUS / NOW</span>
          <a class="home-text-link" href="/now">What I’m doing <span aria-hidden="true">↗</span></a>
        </div>
        <span class="home-mini-label"><span class="home-status-dot"></span> MAIN PROJECT</span>
        <h2>EthioNet Pulse</h2>
        <p>A local network-reliability monitor for checking connectivity, keeping outage history, and making troubleshooting more evidence-based.</p>
        <div class="home-focus-line">
          <span>Also working on</span>
          <strong>Linux · Cisco Packet Tracer · TryHackMe</strong>
        </div>
        <a class="home-arrow-link" href="/now">Read my current field log <span aria-hidden="true">→</span></a>
      </div>

      <div class="home-lower-card home-writing-card">
        <div class="home-section-mini">
          <span class="kicker">FIELD NOTES / {writingPosts.length.toString().padStart(2, '0')} POSTS</span>
          <a class="home-text-link" href="/writing">The notebook <span aria-hidden="true">↗</span></a>
        </div>
        <div class="home-recent-notes">
          {recentWriting.map((post) => (
            <a class="home-recent-note" href={post.url ?? '/writing'}>
              <span class="home-note-date">{formatDate(post.frontmatter.date)}</span>
              <span class="home-note-title">{post.frontmatter.title}</span>
              <span class="home-note-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <a class="home-arrow-link" href="https://github.com/Ezra2121-et/portfolio/new/main/src/pages/writing" target="_blank" rel="noreferrer">Write a new note on GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="home-stack-strip" aria-label="Selected tools">
      <span class="home-stack-label">TOOLS I USE</span>
      <div class="home-stack-tags">{stack.slice(0, 9).map((item) => <span>{item}</span>)}</div>
    </section>

    <section class="home-contact-band">
      <div>
        <div class="kicker">LET’S CONNECT</div>
        <h2>Good work starts with a useful question.</h2>
        <p>I’m looking for entry-level IT support, networking or junior cybersecurity roles. You can also contact me about my projects.</p>
      </div>
      <a class="home-button home-button-primary" href={'mailto:' + site.email}>Email Yosef <Icon name="mail" /></a>
    </section>
  </div>

  <script>
    const syncGithubDates = () => {
      const githubCards = Array.from(document.querySelectorAll('[data-github-repo]'));
      const githubSyncStatus = document.querySelector('#github-sync-status');

      if (!githubCards.length || !githubSyncStatus) return;

      fetch('https://api.github.com/users/Ezra2121-et/repos?per_page=100', {
        headers: { Accept: 'application/vnd.github+json' }
      })
        .then((response) => {
          if (!response.ok) throw new Error('GitHub repository lookup failed');
          return response.json();
        })
        .then((repositories) => {
          let updatedCards = 0;
          githubCards.forEach((card) => {
            const repoUrl = (card.dataset.githubRepo || '').toLowerCase();
            const repository = repositories.find((item) => (item.html_url || '').toLowerCase() === repoUrl);
            const dateLabel = card.querySelector('[data-repo-updated]');
            if (repository && repository.pushed_at && dateLabel) {
              dateLabel.textContent = 'PUSHED ' + new Date(repository.pushed_at).toLocaleDateString(undefined, {
                year: 'numeric', month: 'short', day: 'numeric'
              }).toUpperCase();
              updatedCards += 1;
            }
          });
          githubSyncStatus.textContent = updatedCards
            ? 'Repository activity dates synced from GitHub.'
            : 'Repository dates are unavailable right now; project links still work.';
        })
        .catch(() => {
          githubSyncStatus.textContent = 'GitHub dates are temporarily unavailable; project links and fallback dates remain visible.';
        });
    };

    // Astro's client router replaces page content; re-sync the new homepage each time.
    document.addEventListener('astro:page-load', syncGithubDates);
  </script>

  <style>
    .home-page { padding:42px 0 10px; }
    .home-hero { display:grid; grid-template-columns:minmax(0,1fr) 238px; gap:28px; align-items:stretch; padding-bottom:38px; border-bottom:1px solid var(--border-thin); }
    .home-intro { display:grid; grid-template-columns:128px minmax(0,1fr); gap:24px; align-items:start; min-width:0; }
    .home-photo-wrap { min-width:0; }
    .home-avatar { display:block; width:128px; height:128px; aspect-ratio:1; object-fit:cover; object-position:center; border-radius:16px; border:1px solid var(--border-strong); box-shadow:0 12px 30px rgba(0,0,0,.18); filter:grayscale(100%); background:var(--panel); }
    .home-photo-caption { display:grid; gap:4px; margin-top:9px; color:var(--text-muted); font:8px/1.4 var(--mono); letter-spacing:.08em; }
    .home-copy { min-width:0; }
    .home-copy > .kicker { margin:2px 0 10px; font-size:9px; }
    .home-greeting { margin:0 0 8px; color:var(--text-muted); font:12px/1.4 var(--mono); }
    .home-copy h1 { margin:0; font-size:clamp(30px,3.65vw,43px); line-height:1.08; letter-spacing:-.04em; overflow-wrap:anywhere; }
    .home-copy h1 span { color:var(--text-muted); font-weight:400; }
    .home-role { margin:13px 0 0; color:var(--accent); font:10px/1.6 var(--mono); letter-spacing:.015em; }
    .home-bio { max-width:520px; margin:15px 0 0; color:var(--text-muted); font-size:13px; line-height:1.8; }
    .home-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:19px; }
    .home-button { display:inline-flex; align-items:center; justify-content:center; gap:9px; min-height:38px; padding:0 14px; border:1px solid var(--border-thin); color:var(--text-light); background:transparent; font:10px/1.2 var(--mono); transition:transform .18s ease,border-color .18s ease,background .18s ease,color .18s ease; }
    .home-button:hover { transform:translateY(-1px); border-color:var(--accent); color:var(--accent); }
    .home-button svg { width:14px; height:14px; }
    .home-button-primary { background:var(--accent); border-color:var(--accent); color:var(--bg); font-weight:600; }
    .home-button-primary:hover { color:var(--bg); background:color-mix(in srgb,var(--accent) 84%,white); }
    .home-socials { display:flex; flex-wrap:wrap; gap:16px; margin-top:18px; }
    .home-socials a { display:inline-flex; gap:6px; align-items:center; color:var(--text-muted); font:9px/1.4 var(--mono); }
    .home-socials a:hover { color:var(--accent); }
    .home-socials svg { width:13px; height:13px; }
    .home-profile-card { align-self:stretch; display:flex; flex-direction:column; justify-content:center; padding:18px; border:1px solid var(--border-thin); background:var(--panel); min-width:0; }
    .home-status { display:flex; align-items:center; gap:8px; color:var(--text-light); font:9px/1.6 var(--mono); }
    .home-status-dot { display:inline-block; width:7px; height:7px; flex:0 0 7px; border-radius:50%; background:#70b995; box-shadow:0 0 0 3px rgba(112,185,149,.12); }
    .home-profile-rule { margin:16px 0 13px; border-top:1px solid var(--border-thin); }
    .home-detail { display:grid; gap:5px; padding:10px 0; border-bottom:1px dashed var(--border-thin); }
    .home-detail span { color:var(--text-muted); font:8px/1.4 var(--mono); letter-spacing:.1em; }
    .home-detail strong { color:var(--text-light); font:12px/1.45 var(--sans); overflow-wrap:anywhere; }
    .home-detail small { color:var(--text-muted); font:10px/1.5 var(--sans); }
    .home-profile-contact { display:flex; gap:8px; justify-content:space-between; align-items:center; margin-top:14px; color:var(--accent); font:9px/1.5 var(--mono); overflow-wrap:anywhere; }
    .home-section { padding:34px 0 6px; }
    .home-section-heading { display:flex; justify-content:space-between; align-items:end; gap:20px; margin-bottom:17px; }
    .home-section-heading .kicker { margin-bottom:7px; }
    .home-section-heading h2 { max-width:610px; margin:0; color:var(--text-light); font:600 clamp(23px,3vw,31px)/1.18 var(--sans); letter-spacing:-.025em; }
    .home-section-heading p { margin:8px 0 0; color:var(--text-muted); font-size:11px; line-height:1.6; }
    .home-text-link { display:inline-flex; align-items:center; gap:8px; flex:0 0 auto; color:var(--accent); font:9px/1.5 var(--mono); }
    .home-text-link:hover { text-decoration:underline; text-underline-offset:4px; }
    .home-project-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
    .home-project-card { display:flex; flex-direction:column; min-width:0; min-height:310px; padding:15px; border:1px solid var(--border-thin); background:var(--panel); transition:transform .18s ease,border-color .18s ease,background .18s ease; }
    .home-project-card:hover { transform:translateY(-2px); border-color:var(--accent); }
    .home-project-top { display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:7px; padding-bottom:11px; border-bottom:1px solid var(--border-thin); }
    .home-project-number { color:var(--text-muted); font:8px/1.4 var(--mono); letter-spacing:.07em; }
    .home-project-status { color:var(--text-muted); font:8px/1.35 var(--mono); padding:3px 5px; background:var(--bg); border:1px solid var(--border-thin); }
    .home-project-status.is-functional { color:#70b995; border-color:rgba(112,185,149,.35); }
    .home-project-kind { margin-top:15px; color:var(--text-muted); font:8px/1.5 var(--mono); text-transform:uppercase; letter-spacing:.06em; }
    .home-project-card h3 { margin:8px 0 9px; color:var(--text-light); font:600 19px/1.25 var(--sans); letter-spacing:-.015em; overflow-wrap:anywhere; }
    .home-project-description { flex:1; margin:0 0 14px; color:var(--text-muted); font-size:11px; line-height:1.75; }
    .home-project-tags { display:flex; flex-wrap:wrap; gap:5px; }
    .home-project-tags .tag { font-size:8px; padding:4px 5px; }
    .home-project-footer { display:flex; flex-direction:column; gap:11px; margin-top:16px; padding-top:11px; border-top:1px solid var(--border-thin); }
    .home-project-date { color:var(--text-muted); font:8px/1.4 var(--mono); letter-spacing:.04em; }
    .home-project-links { display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px; }
    .home-project-links a { display:inline-flex; align-items:center; gap:5px; color:var(--accent); font:9px/1.4 var(--mono); }
    .home-project-links a:hover { text-decoration:underline; text-underline-offset:4px; }
    .home-project-links svg { width:12px; height:12px; }
    .home-sync-status { min-height:12px; margin:12px 0 0; color:var(--text-muted); font-size:8px; line-height:1.6; }
    .home-lower-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; padding:30px 0 22px; }
    .home-lower-card { display:flex; flex-direction:column; min-width:0; padding:19px; border:1px solid var(--border-thin); background:var(--bg); }
    .home-section-mini { display:flex; justify-content:space-between; align-items:start; gap:10px; padding-bottom:14px; border-bottom:1px solid var(--border-thin); }
    .home-section-mini .kicker { margin:0; font-size:8px; }
    .home-mini-label { display:flex; align-items:center; gap:8px; margin-top:17px; color:var(--text-muted); font:8px/1.4 var(--mono); letter-spacing:.07em; }
    .home-now-card h2 { margin:10px 0 8px; color:var(--text-light); font:600 23px/1.2 var(--sans); }
    .home-now-card > p { margin:0; color:var(--text-muted); font-size:12px; line-height:1.75; }
    .home-focus-line { display:grid; gap:6px; margin-top:17px; padding-top:12px; border-top:1px dashed var(--border-thin); }
    .home-focus-line span { color:var(--text-muted); font:8px/1.4 var(--mono); text-transform:uppercase; letter-spacing:.06em; }
    .home-focus-line strong { color:var(--text-light); font:11px/1.5 var(--sans); }
    .home-arrow-link { display:inline-flex; align-items:center; gap:8px; align-self:flex-start; margin-top:auto; padding-top:18px; color:var(--accent); font:9px/1.5 var(--mono); }
    .home-arrow-link:hover { text-decoration:underline; text-underline-offset:4px; }
    .home-recent-notes { display:flex; flex-direction:column; }
    .home-recent-note { display:grid; grid-template-columns:64px minmax(0,1fr) 12px; align-items:start; gap:10px; padding:13px 0; border-bottom:1px dashed var(--border-thin); }
    .home-recent-note:last-child { border-bottom:0; }
    .home-recent-note:hover .home-note-title { color:var(--accent); }
    .home-note-date { color:var(--text-muted); font:8px/1.5 var(--mono); }
    .home-note-title { color:var(--text-light); font:12px/1.45 var(--sans); transition:color .18s ease; }
    .home-note-arrow { color:var(--accent); font:10px/1.4 var(--mono); }
    .home-stack-strip { display:flex; align-items:flex-start; gap:20px; padding:17px 0; border-top:1px solid var(--border-thin); border-bottom:1px solid var(--border-thin); }
    .home-stack-label { flex:0 0 auto; padding-top:5px; color:var(--text-muted); font:8px/1.4 var(--mono); letter-spacing:.1em; }
    .home-stack-tags { display:flex; flex-wrap:wrap; gap:6px; }
    .home-stack-tags span { padding:4px 7px; border:1px solid var(--border-thin); color:var(--text-muted); font:8px/1.4 var(--mono); }
    .home-contact-band { display:flex; justify-content:space-between; align-items:center; gap:28px; margin:28px 0 8px; padding:24px; border:1px solid var(--border-thin); background:var(--panel); }
    .home-contact-band .kicker { margin-bottom:7px; }
    .home-contact-band h2 { margin:0; color:var(--text-light); font:600 clamp(21px,2.8vw,28px)/1.2 var(--sans); letter-spacing:-.02em; }
    .home-contact-band p { max-width:570px; margin:9px 0 0; color:var(--text-muted); font-size:11px; line-height:1.7; }
    @media(max-width:980px) {
      .home-hero { grid-template-columns:minmax(0,1fr) 220px; gap:18px; }
      .home-intro { grid-template-columns:108px minmax(0,1fr); gap:18px; }
      .home-avatar { width:108px; height:108px; border-radius:14px; }
      .home-project-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
    @media(max-width:740px) {
      .home-page { padding-top:27px; }
      .home-hero { grid-template-columns:1fr; gap:18px; padding-bottom:25px; }
      .home-intro { grid-template-columns:94px minmax(0,1fr); gap:15px; }
      .home-avatar { width:94px; height:94px; border-radius:13px; }
      .home-photo-caption { font-size:7px; letter-spacing:.04em; }
      .home-copy > .kicker { font-size:8px; }
      .home-copy h1 { font-size:clamp(27px,6vw,37px); }
      .home-bio { font-size:12px; }
      .home-profile-card { display:grid; grid-template-columns:1fr 1fr; gap:0 16px; padding:15px; }
      .home-status { grid-column:1/-1; }
      .home-profile-rule { grid-column:1/-1; margin:12px 0 7px; }
      .home-profile-card .home-detail:last-of-type { border-bottom:0; }
      .home-profile-contact { grid-column:1/-1; border-top:1px dashed var(--border-thin); padding-top:12px; }
      .home-section { padding-top:27px; }
      .home-section-heading { align-items:flex-start; }
      .home-project-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
      .home-lower-grid { grid-template-columns:1fr; padding-top:22px; }
      .home-contact-band { align-items:flex-start; flex-direction:column; padding:19px; }
    }
    @media(max-width:520px) {
      .home-intro { grid-template-columns:78px minmax(0,1fr); gap:12px; }
      .home-avatar { width:78px; height:78px; border-radius:12px; }
      .home-photo-caption span:last-child { display:none; }
      .home-copy > .kicker { letter-spacing:.06em; }
      .home-greeting { font-size:10px; }
      .home-copy h1 { font-size:clamp(25px,7.3vw,34px); }
      .home-role { font-size:9px; }
      .home-actions { gap:7px; }
      .home-button { min-height:35px; padding:0 10px; font-size:9px; }
      .home-socials { gap:12px; }
      .home-section-heading { display:block; }
      .home-section-heading .home-text-link { margin-top:10px; }
      .home-project-grid { grid-template-columns:1fr; }
      .home-project-card { min-height:0; padding:16px; }
      .home-project-footer { flex-direction:row; align-items:center; justify-content:space-between; }
      .home-project-links { justify-content:flex-end; }
      .home-stack-strip { display:block; }
      .home-stack-tags { margin-top:10px; }
      .home-section-mini { flex-wrap:wrap; }
      .home-recent-note { grid-template-columns:58px minmax(0,1fr) 12px; gap:7px; }
    }
    @media(prefers-reduced-motion:reduce) {
      .home-project-card,.home-button { transition:none; }
      .home-project-card:hover,.home-button:hover { transform:none; }
    }
  </style>
</Base>
