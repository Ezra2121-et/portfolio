---
import Base from '../layouts/Base.astro';
import { projects } from '../data/site';
---
<Base title="Work" description="Projects and lab write-ups by Yosef Getnet.">
  <div class="shell page">
    <div class="kicker">Work</div>
    <h1>Projects & labs.</h1>
    <p class="page-intro">Selected projects backed by public repositories. Each entry is labelled honestly as a prototype or internship project, with source code linked wherever it is available.</p>
    <div class="grid-3">
      {projects.map(project => (
        <article class="project panel">
          <div class="project-top"><span class="project-num">{project.number}</span><span class="project-status">{project.status}</span></div>
          <div class="project-kind">{project.kind}</div>
          <h2 class="project-title" style="margin-top:8px">{project.title}</h2>
          <p class="project-desc">{project.description}</p>
          <div class="tags">{project.stack.map(tag => <span class="tag">{tag}</span>)}</div>
          <div class="project-foot">
            <span class="muted mono">{project.year}</span>
            <span class="mono" style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
              <a class="arrow mono" href={project.href}>case study →</a>
              {project.source && <a class="arrow mono" href={project.source} target="_blank" rel="noreferrer">source ↗</a>}
              {project.demo && <a class="arrow mono" href={project.demo} target="_blank" rel="noreferrer">project URL ↗</a>}
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>
