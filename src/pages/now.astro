---
import Base from '../layouts/Base.astro';
import { currently } from '../data/site';
---
<Base title="Now" description="What Yosef Getnet is currently working on and researching.">
  <div class="shell page">
    <div class="kicker">Now</div>
    <h1>Current focus.</h1>
    <p class="page-intro">What I am studying and building right now, updated as my focus shifts.</p>
    <div class="trio">
      <div class="panel list-panel"><div class="panel-head">Primary focus</div><div class="list">{currently.map(item => <div class="list-item"><span>› {item}</span><span>●</span></div>)}</div></div>
      <div class="panel list-panel"><div class="panel-head">Learning</div><div class="list"><div class="list-item"><span>Cisco networking (CCNA)</span><span>prep</span></div><div class="list-item"><span>ISC2 CC</span><span>prep</span></div><div class="list-item"><span>Web &amp; API security</span><span>labs</span></div><div class="list-item"><span>Python automation</span><span>building</span></div></div></div>
      <div class="panel list-panel"><div class="panel-head">Approach</div><div class="callout"><h3>Systematic practice.</h3><p>I learn by doing and writing it down: labs, notes and write-ups that show how I work through a problem, not just the result.</p></div></div>
    </div>
  </div>
</Base>
