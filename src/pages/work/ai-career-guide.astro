---
import Base from '../../layouts/Base.astro';
---
<Base title="AI-Based Career Guide">
  <div class="shell page">
    <div class="kicker">// PROJECT 01 · CAPSTONE 2026</div>
    <h1>AI-Based Career Guide.</h1>
    <p class="page-intro">A web platform for skill-gap analysis, resume building and mock interviews, built as my Computer Science capstone.</p>
    <div class="article"><div class="prose">
      <h2>What it does</h2>
      <p>Helps a job seeker compare their skills against what a role asks for, build a resume, and practice with mock interviews.</p>
      <h2>Stack</h2>
      <div class="tags"><span class="tag">TypeScript</span><span class="tag">PostgreSQL</span><span class="tag">Prisma ORM</span><span class="tag">Gemini AI</span></div>
    </div></div>
  </div>
</Base>
