---
import Base from '../layouts/Base.astro';
import { writing } from '../data/site';
---
<Base title="Writing" description="Personal learning notes and technical reflections by Yosef Getnet.">
  <div class="shell page">
    <div class="kicker">Writing</div>
    <h1>Notes & write-ups.</h1>
    <p class="page-intro">Short learning notes and reflections from my work with Linux, networking, cybersecurity and systems. These are personal learning records—not formal research papers—and I will keep adding concrete lessons as I build and test projects.</p>
    <div class="writing-list">
      {writing.map(item => (
        <a class="writing-row" href={item.href}>
          <span class="writing-title">{item.title}</span>
          <span class="writing-meta"><span>#{item.category}</span>{item.tags.map(tag => <span>#{tag}</span>)}</span>
          <span class="writing-date">{item.date}</span>
        </a>
      ))}
    </div>
  </div>
</Base>
